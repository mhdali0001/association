APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# صفحتا Privacy Policy و Terms of Service (مطلوبتان لشاشة موافقة Google)
ORG_NAME_EN="Masalek Al-Nour Charitable Foundation"
CONTACT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── النسخ الاحتياطي (spatie/laravel-backup) ──
# على الخادم اضبط: BACKUP_DISKS=google (Google Drive فقط، بلا نسخة على الخادم)
BACKUP_DISKS=backups
# فارغ = بلا تشفير. لو وُضعت كلمة سر يُشفَّر ملف zip بـ AES-256 ولا يُفتح بدونها.
BACKUP_ARCHIVE_PASSWORD=
# بريد يصله تنبيه عند فشل النسخ (الوجهة الوحيدة هي Drive، فالتنبيه هو ما يكشف الفشل)
BACKUP_NOTIFICATION_EMAIL=
# Google Drive (OAuth Client من Google Cloud + Refresh Token بصلاحية drive.file).
# يجب نشر شاشة الموافقة (In production)؛ في وضع Testing ينتهي الـ Refresh Token بعد 7 أيام.
# للفحص: php artisan backup:test-google


VITE_APP_NAME="${APP_NAME}"
